# Chi-Town Customs USA — Environment Configuration Template
# Copy this file to .env.local for local development.

# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (SQLite local file by default, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/chitown_customs?schema=public"

# Session & JWT Secrets
SESSION_SECRET="chitown_customs_super_secure_production_secret_key_2026_x89"

# Stripe Payment Provider (Sandbox / Test Mode)
STRIPE_SECRET_KEY="sk_test_placeholder_for_chitown_customs"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_for_chitown_customs"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_for_chitown_customs"

# Business Information Defaults (Verified)
BUSINESS_NAME="Chi-Town Customs USA"
BUSINESS_ADDRESS="311 N Cicero Ave, Chicago, IL 60644"
BUSINESS_PHONE="+1 773-287-3000"

# Financing Provider Configuration
FINANCING_PROVIDER="SNAP_ACIMA_AFFIRM"
FINANCING_REFERRAL_URL="https://consumer.snapfinance.com/#/pre-approval"

# Email Provider Configuration (Resend, SendGrid, or SMTP)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="orders@chitowncustoms.com"
